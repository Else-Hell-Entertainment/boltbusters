config_version=5

[application]

config/name="Bolt Busters"
config/version="a1.0.0"
run/main_scene="uid://b35amjbo2hqe5"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

TargetProvider="*res://Code/TargetProvider.cs"
GameManager="*res://Code/Systems/GameManager.cs"
MusicManager="*res://Code/Systems/MusicManager.cs"

[display]

window/stretch/mode="viewport"

[dotnet]

project/assembly_name="Bolt Busters"

[file_customization]

folder_colors={
"res://Assets/": "red",
"res://Code/": "orange",
"res://Data/": "yellow",
"res://Scenes/": "green",
"res://Temp/": "gray",
"res://ThirdParty/Assets/": "red",
"res://ThirdParty/Code/": "orange"
}

